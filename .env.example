# Copy to .env and adjust as needed: cp .env.example .env

# --- Database (MariaDB) ---
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_DATABASE=recipe_ai
MARIADB_USER=recipe
MARIADB_PASSWORD=recipe
DB_HOST_PORT=3307

# --- Symfony backend ---
APP_ENV=dev
APP_SECRET=change_me_to_a_random_string
API_HOST_PORT=8000
JWT_PASSPHRASE=change_me_jwt_passphrase

# --- AI / Claude ---
# Leave empty for now; add your Anthropic API key after implementation.
ANTHROPIC_API_KEY=
# Any model id supported by the Symfony AI Anthropic bridge, e.g.
# claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-8
AI_MODEL=claude-sonnet-4-5

# --- Frontend (React SPA) ---
FRONTEND_HOST_PORT=5173
VITE_API_URL=http://localhost:8000/api
CORS_ALLOW_ORIGIN=^https?://localhost:(5173|3000)$
