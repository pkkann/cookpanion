# Copy to .env and adjust as needed: cp .env.example .env

# --- Symfony backend ---
APP_ENV=dev
APP_SECRET=change_me_to_a_random_string
JWT_PASSPHRASE=change_me_jwt_passphrase

# --- AI / Claude ---
# Leave empty to disable AI features (endpoints return 503, app keeps working).
ANTHROPIC_API_KEY=
# Any model id supported by the Symfony AI Anthropic bridge, e.g.
# claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-8
AI_MODEL=claude-sonnet-4-5

# --- Google sign-in ---
# Google OAuth *Web* client id (public; no secret). Empty = button hidden and
# /api/auth/google returns 503. Served to the SPA at runtime via /api/config.
GOOGLE_CLIENT_ID=

# --- App (single origin: SPA + API behind nginx) ---
# Open the app at http://localhost:5173 or http://<your-lan-ip>:5173.
APP_HOST_PORT=5173
# Relative on purpose (same origin). Only override if you split the services.
VITE_API_URL=/api
CORS_ALLOW_ORIGIN=^https?://localhost:(5173|3000)$

# --- Dev conveniences ---
# Load demo fixtures on container start (dev only).
LOAD_FIXTURES=false
